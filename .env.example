# Copy to .env (chmod 600). Secrets can also be set from Admin -> Engine / Security.
MWT_HOST=0.0.0.0
MWT_PORT=8080
# MWT_DATA_DIR=/home/cat/mywebtools/data

# Optional access password for the web UI
APP_PASSWORD=

# Large language model / speech API key (OpenAI by default, see Admin -> AI model)
LLM_API_KEY=

# Only for the optional DUIX cloud engine (default engine is the Duix Docker container on Windows)
DUIX_API_KEY=

# Workers per lane: cpu = ffmpeg/OCR/Whisper, net = cloud/LAN waits, light = quick jobs
MWT_LANE_CPU=1
MWT_LANE_NET=3
MWT_LANE_LIGHT=2

# FFMPEG_CMD=ffmpeg
# FFPROBE_CMD=ffprobe
# TESSERACT_CMD=tesseract
